        <mxCell id="s1_r3c1" value="Estimated Storage (excluding replicas and backups)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="524" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s1_r3c2" value="1.5 PB / month" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="524" width="230" height="34" as="geometry" />
        </mxCell>

        <!-- 3.2 Bandwidth Estimation -->
        <mxCell id="s2title" value="3.2 Bandwidth Estimation" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="580" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s2intro" value="Assume the platform streams approximately 1 billion video views per day, with an average streamed size of 500 MB." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="608" width="750" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s2_h1" value="Step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
