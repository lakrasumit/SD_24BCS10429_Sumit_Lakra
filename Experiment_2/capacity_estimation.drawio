          <mxGeometry x="520" y="456" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s1_r2c1" value="Monthly Storage = 30 x 50 TB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="490" width="470" height="34" as="geometry" />
