        <!-- 3.1 Storage Estimation -->
        <mxCell id="s1title" value="3.1 Storage Estimation" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="360" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s1intro" value="Assume around 100,000 new videos are uploaded every day, and the average video size is 500 MB." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="388" width="750" height="30" as="geometry" />
        </mxCell>

        <mxCell id="s1_h1" value="Step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
