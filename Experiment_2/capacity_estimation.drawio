          <mxGeometry x="520" y="883" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s3_r1c1" value="Number of Streaming Servers = 100 Million / 50,000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="917" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s3_r1c2" value="2,000 Servers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="917" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s3_r2c1" value="Estimated Streaming Servers (excluding CDN edge servers)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="951" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s3_r2c2" value="2,000 Servers" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="951" width="230" height="34" as="geometry" />
        </mxCell>

        <!-- 3.4 RPS Estimation -->
        <mxCell id="s4title" value="3.4 Requests Per Second (RPS) Estimation" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="1005" width="500" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s4intro" value="To estimate the traffic handled by the platform, calculate the average number of streaming requests processed every second. Assume Netflix serves 1 billion video play requests per day." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="1033" width="750" height="40" as="geometry" />
        </mxCell>

        <mxCell id="s4_h1" value="Step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1078" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s4_h2" value="Value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="1078" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s4_r1c1" value="RPS = 1 Billion / 86,400" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1112" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s4_r1c2" value="approx. 11,574 req/s (~11.5K RPS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="1112" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s4_r2c1" value="Estimated Traffic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="1146" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s4_r2c2" value="~11.5K RPS (higher at peak)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="1146" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s4note" value="Note: This is an average estimation. During peak hours (evenings, weekends, or new content releases), actual RPS can be several times higher, so the system should be designed to handle sudden traffic spikes efficiently." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="1184" width="750" height="40" as="geometry" />
        </mxCell>

