        </mxCell>
        <mxCell id="s1_h2" value="Value" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="422" width="230" height="34" as="geometry" />
        </mxCell>

