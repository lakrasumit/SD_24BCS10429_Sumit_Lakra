  <diagram name="Capacity Estimation" id="capacity-estimation">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageWidth="900" pageHeight="1300" math="0" shadow="0">
