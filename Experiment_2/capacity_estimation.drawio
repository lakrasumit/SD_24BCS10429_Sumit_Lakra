          <mxGeometry x="520" y="676" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s2_r2c1" value="Bandwidth = 500 PB / 86,400 seconds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="710" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s2_r2c2" value="approx. 46 Tb/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="710" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s2_r3c1" value="Estimated Bandwidth" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="744" width="470" height="34" as="geometry" />
        </mxCell>
        <mxCell id="s2_r3c2" value="~46 Tb/s" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D9D9D9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="520" y="744" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s2note" value="Note: Most of this bandwidth is handled through geographically distributed CDNs rather than the origin servers." style="text;html=1;fontSize=11;fontStyle=2;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="782" width="700" height="26" as="geometry" />
