        <!-- Main Title -->
        <mxCell id="maintitle" value="3. Capacity Estimation" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="500" height="35" as="geometry" />
        </mxCell>
        <mxCell id="mainintro" value="Before designing the architecture, we estimate the expected traffic, storage, and bandwidth requirements. These estimations help us choose the right CDN, storage, database, cache, and scaling strategy." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="55" width="750" height="40" as="geometry" />
