          <mxGeometry x="520" y="642" width="230" height="34" as="geometry" />
        </mxCell>

        <mxCell id="s2_r1c1" value="Daily Data Transfer = 1 Billion x 500 MB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="676" width="470" height="34" as="geometry" />
