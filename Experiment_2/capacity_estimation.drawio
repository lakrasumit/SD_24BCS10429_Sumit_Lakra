        <mxCell id="s3title" value="3.3 Server Estimation" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="50" y="825" width="400" height="25" as="geometry" />
        </mxCell>
        <mxCell id="s3intro" value="Assume a single streaming server can handle approximately 50,000 concurrent streaming sessions." style="text;html=1;fontSize=12;align=left;verticalAlign=top;fontColor=#000000;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="50" y="853" width="750" height="26" as="geometry" />
        </mxCell>

        <mxCell id="s3_h1" value="Step" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6E6E6;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=12;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="883" width="470" height="34" as="geometry" />
