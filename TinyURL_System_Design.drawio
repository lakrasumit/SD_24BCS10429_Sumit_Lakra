        <mxCell id="c2" value="/{code}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="120" y="510" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="c3" value="Redirect to long URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="510" width="240" height="30" as="geometry"/></mxCell>

