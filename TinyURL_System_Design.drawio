  <diagram name="Architecture" id="architecture">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="826">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title3" value="TinyURL — High Level Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell>

        <mxCell id="u" value="USER&#xa;&#xa;Create links&#xa;Open short links" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cce5ff;strokeColor=#36393d;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="gw" value="API GATEWAY&#xa;&#xa;Authentication&#xa;Request routing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="250" y="145" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="rl" value="RATE LIMITER&#xa;&#xa;Controls repeated requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="145" width="170" height="90" as="geometry"/></mxCell>

        <mxCell id="api1" value="URL SERVICE&#xa;&#xa;Create code&#xa;Validate URL&#xa;Redirect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="130" width="170" height="120" as="geometry"/></mxCell>

        <mxCell id="cache" value="REDIS&#xa;&#xa;short_code → long_url&#xa;TTL for popular links" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="db" value="POSTGRESQL&#xa;&#xa;URL mappings&#xa;Users&#xa;Expiry & status" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="570" y="350" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="analytics" value="ANALYTICS WORKER&#xa;&#xa;Processes click events&#xa;Updates counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="350" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="queue" value="MESSAGE QUEUE&#xa;&#xa;Click events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="1"><mxGeometry x="850" y="515" width="190" height="80" as="geometry"/></mxCell>

        <mxCell id="e1" edge="1" parent="1" source="u" target="gw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="gw" target="rl" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="rl" target="api1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="api1" target="cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;" value="lookup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="api1" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;" value="cache miss / write"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="api1" target="queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;" value="click event"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" edge="1" parent="1" source="queue" target="analytics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#333;"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="flow1" value="Create URL: validate → generate ID → Base62 → PostgreSQL → Redis" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="430" height="55" as="geometry"/></mxCell>
        <mxCell id="flow2" value="Redirect: Redis hit → redirect; miss → PostgreSQL → populate Redis → redirect" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;dashed=1;align=left;fontSize=10;" vertex="1" parent="1"><mxGeometry x="540" y="650" width="500" height="55" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
