<mxfile host="app.diagrams.net" pages="3">
  <diagram name="Requirements & Estimation" id="requirements">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="826">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>

        <mxCell id="title" value="TinyURL — Medium Scale System Design" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="frh" value="1. Functional Requirements" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="300" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="fr" value="- Create a short URL from a long URL&#xa;- Redirect users to the original URL&#xa;- Allow custom aliases&#xa;- Allow URL expiration&#xa;- Let users disable their own links&#xa;- Track basic click count&#xa;- Reject invalid or unsafe URLs"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="310" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="nfrh" value="2. Non-Functional Requirements" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="85" width="330" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="nfr" value="- Availability: 99.9%&#xa;- Redirect latency: &lt;150 ms for cached links&#xa;- Peak traffic: ~8,000 requests/sec&#xa;- Durable storage with backups&#xa;- Unique short codes&#xa;- HTTPS and basic abuse protection"
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=12;spacingLeft=8;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="380" y="115" width="330" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="assh" value="3. Back-of-the-Envelope Estimation" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="335" width="450" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="ass" value="Assumptions: 2 million new URLs/day, 300 million redirects/day, average mapping size 700 bytes, 3 years retention"
          style="text;html=1;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="850" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="mh" value="Metric" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="eh" value="Estimate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="180" height="30" as="geometry"/></mxCell>

        <mxCell id="m1" value="New URLs/day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e1" value="2 million" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="430" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="m2" value="Redirects/day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e2" value="300 million" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="460" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="m3" value="Average read QPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e3" value="~3,500" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="490" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="m4" value="Peak QPS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e4" value="~8,000" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="520" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="m5" value="Storage/year" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="550" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e5" value="~0.5 TB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="550" width="180" height="30" as="geometry"/></mxCell>
        <mxCell id="m6" value="Storage/3 years" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="250" height="30" as="geometry"/></mxCell>
        <mxCell id="e6" value="~1.5 TB" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;fontSize=12;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="290" y="580" width="180" height="30" as="geometry"/></mxCell>

        <mxCell id="note" value="Design choice: traffic is read-heavy, so a cache is placed before the database."
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;fontSize=11;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="625" width="500" height="45" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Database & API" id="database-api">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1169" pageHeight="826">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="t" value="Database & API Design" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1080" height="40" as="geometry"/></mxCell>

        <mxCell id="dh" value="4. Database Design (PostgreSQL)" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="400" height="25" as="geometry"/></mxCell>
        <mxCell id="uh" value="USER" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="220" height="30" as="geometry"/></mxCell>
        <mxCell id="ub" value="user_id BIGINT PK&#xa;email VARCHAR UNIQUE&#xa;created_at TIMESTAMP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;fontFamily=Courier New;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="90" as="geometry"/></mxCell>

        <mxCell id="lh" value="URL_MAPPING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="300" height="30" as="geometry"/></mxCell>
        <mxCell id="lb" value="url_id BIGINT PK&#xa;short_code VARCHAR(8) UNIQUE&#xa;long_url TEXT&#xa;user_id BIGINT FK&#xa;created_at TIMESTAMP&#xa;expires_at TIMESTAMP&#xa;click_count BIGINT&#xa;status VARCHAR(20)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;align=left;verticalAlign=top;fontSize=11;fontFamily=Courier New;spacingLeft=8;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="300" height="170" as="geometry"/></mxCell>

        <mxCell id="rel" value="1 → N" edge="1" parent="1" source="uh" target="lh" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=open;strokeColor=#000000;fontSize=11;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="idx" value="Indexes: UNIQUE(short_code), INDEX(user_id), INDEX(expires_at)" style="text;html=1;align=left;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="600" height="25" as="geometry"/></mxCell>

        <mxCell id="ah" value="5. API Design" style="text;html=1;align=left;verticalAlign=top;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="385" width="250" height="25" as="geometry"/></mxCell>
        <mxCell id="h1" value="Method" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="h2" value="Endpoint" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="120" y="420" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="h3" value="Purpose" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="420" width="240" height="30" as="geometry"/></mxCell>

        <mxCell id="a1" value="POST" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="80" height="30" as="geometry"/></mxCell>
        <mxCell id="a2" value="/api/v1/links" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="120" y="450" width="280" height="30" as="geometry"/></mxCell>
        <mxCell id="a3" value="Create short URL" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff;strokeColor=#000;align=left;fontSize=11;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="400" y="450" width="240" height="30" as="geometry"/></mxCell>

